OPENROUTER_API_KEY=
# Optional vision model on OpenRouter
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
DEEPSEEK_API_KEY=
# Optional: Gemini vision OCR if client OCR is weak
# GEMINI_API_KEY=
# JWT for sign-in (required on Vercel)
# FOLIO_JWT_SECRET=
# Google sign-in (OAuth 2.0 Web client ID from Google Cloud Console)
# Add your local and production origins as Authorized JavaScript origins, e.g.
# http://localhost:8000 and https://your-app.vercel.app
# GOOGLE_CLIENT_ID=
# Postgres — required for cross-device sync (same Google account on phone + laptop).
# Easiest: Supabase → Project Settings → Database → Connection string (URI).
# Use the "Transaction" pooler URI (port 6543) on Vercel, or Session/direct (5432) locally.
# Example: postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=
# Also accepted: POSTGRES_URL, POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED
# Optional fallback: persist contacts across cold starts (Vercel Blob) if no Postgres
# BLOB_READ_WRITE_TOKEN=
