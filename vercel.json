{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"require('fs').cpSync('FrontendBucket','public',{recursive:true})\"",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tmp/**,docs/**,application/layer/**,FrontendBucket/**,public/**,.git/**,.aws-sam/**,.npm-cache/**,.tmp/**}"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
